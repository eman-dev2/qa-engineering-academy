{
  "name": "qa-engineering-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/prepare.ts --demo && next dev",
    "build": "tsx scripts/prepare.ts && next build",
    "start": "tsx scripts/prepare.ts && next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/prepare.ts",
    "db:seed": "tsx seed/index.ts",
    "db:setup": "tsx seed/index.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "user:role": "tsx scripts/set-role.ts"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/noto-naskh-arabic": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@shikijs/rehype": "^4.5.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "shiki": "^4.5.0",
