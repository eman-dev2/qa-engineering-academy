# Copy to .env.local for local overrides. Every variable is optional in development.

# Where the SQLite database lives (default: ./data/academy.db).
# DATABASE_PATH=./data/academy.db

# Public address of the site, used in password-reset links, canonical URLs and the sitemap.
# Set it in production (on Render, RENDER_EXTERNAL_URL is used automatically when this is empty).
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# First administrator, created when the server starts and no administrator exists yet.
# Server-side only: never exposed to the browser. Remove after the first start if you like.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=choose-a-strong-password-1
# ADMIN_NAME=Your Name

# Password for the development demo accounts (default: Demo-Password-2026). Ignored in production.
# DEMO_PASSWORD=Demo-Password-2026

# Allow session cookies over plain http when testing `npm start` on a LAN address (never in real production).
# INSECURE_COOKIES=1
